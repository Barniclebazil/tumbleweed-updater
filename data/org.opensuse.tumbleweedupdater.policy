<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Tumbleweed Updater</vendor>
  <vendor_url>https://github.com/Barniclebazil/tumbleweed-updater</vendor_url>
  <icon_name>tumbleweed-updater</icon_name>

  <!-- Repository refresh + dry-run only: no password for an active local
       session, since it changes nothing on the system. -->
  <action id="org.opensuse.tumbleweedupdater.check">
    <description>Check for openSUSE Tumbleweed updates</description>
    <message>Authentication is required to refresh repositories and check for updates</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tumbleweed-updater/check</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!-- Rewrites a systemd timer drop-in: needs admin auth. -->
  <action id="org.opensuse.tumbleweedupdater.set-interval">
    <description>Change the automatic update-check schedule</description>
    <message>Authentication is required to change the update-check schedule</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tumbleweed-updater/set-interval</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!-- Reading snapshots: even listing needs root, since `snapper list` refuses
       to run as a normal user. Read-only, and the dialog lists repeatedly, so
       the authorisation may stay cached. -->
  <action id="org.opensuse.tumbleweedupdater.snapshots">
    <description>List and compare Btrfs snapshots</description>
    <message>Authentication is required to list Btrfs snapshots</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tumbleweed-updater/snapshots</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!-- Changing snapshots: rollback picks what boots next and delete cannot be
       undone. Deliberately plain auth_admin, not auth_admin_keep: a cached
       authorisation from the listing above must not be reusable to destroy
       anything, so each of these prompts. -->
  <action id="org.opensuse.tumbleweedupdater.snapshots-manage">
    <description>Roll back or delete a Btrfs snapshot</description>
    <message>Authentication is required to roll back or delete a Btrfs snapshot</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tumbleweed-updater/snapshots-manage</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!-- The actual upgrade. -->
  <action id="org.opensuse.tumbleweedupdater.update">
    <description>Install openSUSE Tumbleweed updates</description>
    <message>Authentication is required to install updates to your system packages via zypper dup</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tumbleweed-updater/run-update</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
