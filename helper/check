#!/usr/bin/python3
"""Privileged update check.

Runs as root (via pkexec / the systemd timer):

1. refresh zypper repositories,
2. compute a dry-run distribution upgrade,
3. note whether snapshot support is present,
4. write the result to the status file the GUI watches.

It never installs anything.
"""

from __future__ import annotations

import datetime
import os
import subprocess
import sys
import time

# Allow running straight from a source checkout (helper/ next to the package).
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from tumbleweed_updater import sources, statusfile  # noqa: E402
from tumbleweed_updater.sources import UpdateStatus  # noqa: E402

# A resume-from-sleep race with PackageKit (triggered by NetworkManager
# reconnecting) is the common case, and zypper fails fast when the lock is
# held rather than waiting, so a handful of short retries costs little even
# in the worst case.
_LOCK_MAX_ATTEMPTS = 3  # 1 initial attempt + up to 2 retries
_LOCK_RETRY_DELAY_S = 10


def _snapshots_ok() -> bool:
    try:
        rpm = subprocess.run(
            ["rpm", "-q", "snapper-zypp-plugin"], capture_output=True, timeout=15
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return rpm.returncode == 0


def _refresh() -> tuple[str | None, bool]:
    """Run ``zypper refresh``.

    Returns ``(error_message, locked)``; ``locked`` is True only when the
    failure was specifically a zypp lock conflict (exit code 7) - the one
    case worth retrying automatically.
    """
    try:
        proc = subprocess.run(
            ["zypper", "--non-interactive", "refresh"],
            capture_output=True,
            text=True,
            timeout=600,
        )
    except FileNotFoundError:
        return "zypper is not installed", False
    except subprocess.TimeoutExpired:
        return "repository refresh timed out", False
    if proc.returncode != 0:
        message = (proc.stderr or proc.stdout).strip()
        if not message:
            message = f"zypper refresh exited {proc.returncode}"
        return message, proc.returncode == sources.ZYPPER_EXIT_ZYPP_LOCKED
    return None, False


def main() -> int:
    attempts = 0
    refresh_error: str | None = None
    zypper = sources.ZypperResult()
    still_locked = False

    while True:
        attempts += 1
        refresh_error, refresh_locked = _refresh()
        zypper = sources.check_zypper()

        still_locked = zypper.error is not None and (zypper.locked or refresh_locked)
        if not still_locked or attempts >= _LOCK_MAX_ATTEMPTS:
            break
        time.sleep(_LOCK_RETRY_DELAY_S)

    if zypper.error is None and refresh_error and not zypper.packages:
        zypper.error = f"repository refresh failed: {refresh_error}"

    if still_locked and attempts > 1:
        elapsed = (attempts - 1) * _LOCK_RETRY_DELAY_S
        zypper.error = (
            f"System management is still locked after {attempts} automatic "
            f"attempts over the last {elapsed}s: {zypper.error}"
        )

    status = UpdateStatus(
        zypper=zypper,
        snapshots_ok=_snapshots_ok(),
        generated=datetime.datetime.now(datetime.timezone.utc).isoformat(
            timespec="seconds"
        ),
    )
    statusfile.write(status)
    return 0


if __name__ == "__main__":
    sys.exit(main())
