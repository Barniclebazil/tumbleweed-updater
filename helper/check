#!/usr/bin/python3
"""Privileged update check.

Runs as root (via pkexec / the systemd timer):

1. refresh zypper repositories,
2. compute a dry-run distribution upgrade,
3. note whether snapshot support is present,
4. write the result to the status file the GUI watches.

Steps 1 and 2 in that order are also how ``helper/run-update`` gets past a
software source that cannot be reached: the dry run uses ``--no-refresh``
(see :func:`tumbleweed_updater.sources.check_zypper`), so a source the refresh
could not reach is still described by the details already on this computer and
its packages are not orphaned. A dup that refreshes for itself refuses to run
at all in that situation.

If our own upgrade is running, this exits at once and writes nothing. A check
during a ``zypper dup`` can tell the user nothing it does not already know, and
the alternative is what used to happen: the retry loop below spent 40 seconds
losing to our own upgrade and then replaced a perfectly good status file with a
failure, so the window threw away its list of updates and put up an orange bar
naming our own zypper's pid. The GUI starts a fresh check the moment an upgrade
ends, so nothing is lost by standing down.

It never installs anything.
"""

from __future__ import annotations

import datetime
import os
import subprocess
import sys
import time

# Running from a source checkout (helper/ sitting next to the package) needs the
# repository root on sys.path; an installed copy does not. Guard on the package
# directory actually being there, because installed this file lives in
# /usr/libexec/tumbleweed-updater and putting /usr/libexec at the front of
# sys.path would let any stray .py file there shadow the standard library in a
# process running as root.
_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if os.path.isdir(os.path.join(_REPO, "tumbleweed_updater")):
    sys.path.insert(0, _REPO)

from tumbleweed_updater import packagekit, repos, sources, statusfile  # noqa: E402
from tumbleweed_updater.paths import HELPER_RUN_UPDATE, resolve_helper  # noqa: E402
from tumbleweed_updater.sources import UpdateStatus  # noqa: E402

# The upgrade helper. Its zypper is what lands in /run/zypp.pid, so it is found
# by ancestry rather than by name; both spellings are listed because an
# installed helper and one run from a checkout are different paths.
_OUR_UPGRADE = tuple({resolve_helper(HELPER_RUN_UPDATE), HELPER_RUN_UPDATE})

# PackageKit holding the zypp lock is the common case: it is D-Bus activated,
# so anything at all asking it a question starts it as root, and it keeps the
# lock for as long as its transaction runs (15-30s for a refresh). zypper fails
# fast when the lock is held rather than waiting, so waiting is up to us.
_LOCK_MAX_ATTEMPTS = 5  # 1 initial attempt + up to 4 retries
_LOCK_RETRY_DELAY_S = 10  # so: up to 40s of waiting, plus the per-attempt wait


def _snapshots_ok() -> bool:
    try:
        rpm = subprocess.run(
            ["rpm", "-q", "snapper-zypp-plugin"], capture_output=True, timeout=15
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return rpm.returncode == 0


def _refresh() -> tuple[str | None, bool, str]:
    """Run ``zypper refresh``.

    Returns ``(error_message, locked, output)``. *locked* is True only when the
    failure was specifically a zypp lock conflict (exit code 7) - the one
    case worth retrying automatically. *output* is everything zypper printed,
    which _failed_sources() below mines for the sources it could not reach.
    """
    try:
        proc = subprocess.run(
            ["zypper", "--non-interactive", "refresh"],
            capture_output=True,
            text=True,
            timeout=600,
            # The source names are recovered from this output by matching the
            # "[alias|url]" token zypper prints. That token is the same in
            # every language, but pinning the locale keeps the rest of the
            # output predictable too, and costs nothing here: no human reads
            # it, the window builds its own wording.
            env={**os.environ, "LC_ALL": "C"},
        )
    except FileNotFoundError:
        return "zypper is not installed", False, ""
    except subprocess.TimeoutExpired:
        return "repository refresh timed out", False, ""
    output = (proc.stdout or "") + (proc.stderr or "")
    if proc.returncode != 0:
        message = (proc.stderr or proc.stdout).strip()
        if not message:
            message = f"zypper refresh exited {proc.returncode}"
        return message, proc.returncode == sources.ZYPPER_EXIT_ZYPP_LOCKED, output
    return None, False, output


def _failed_sources(refresh_output: str) -> list[tuple[str, str]]:
    """Which software sources the refresh could not reach, as (alias, name).

    Every alias is checked against the real source list before it is recorded,
    so nothing the window later hands back to helper/repos can have been
    invented by a stray line of output.
    """
    if not refresh_output.strip():
        return []
    listing = repos.list_repos()
    if listing.error:
        return []
    aliases = repos.failed_aliases(refresh_output, [r.alias for r in listing.repos])
    out = []
    for alias in aliases:
        repo = listing.by_alias(alias)
        if repo is not None:
            out.append((repo.alias, repo.label))
    return out


def main() -> int:
    # This helper takes no arguments at all. polkit's exec.path annotation pins
    # the program but never its argv, so anything at all is refused here rather
    # than parsed. It used to accept --no-wait-for-packagekit, which carried a
    # preference the scheduled run could not read anyway; waiting is now simply
    # what it does.
    if sys.argv[1:]:
        sys.stderr.write(
            "check: refusing unrecognised option(s): "
            + " ".join(sys.argv[1:])
            + "\n"
        )
        return 2

    # Before the loop, and before anything is written: see the module docstring.
    if packagekit.holder_is_ours(packagekit.lock_holder(), _OUR_UPGRADE):
        sys.stderr.write(
            "check: an upgrade is running; leaving the last result alone\n"
        )
        return 0

    attempts = 0
    refresh_error: str | None = None
    refresh_output = ""
    zypper = sources.ZypperResult()
    still_locked = False
    lock_detail = ""

    while True:
        attempts += 1
        # Inside the loop, not once before it: whatever woke PackageKit the
        # first time (Plasma's Discover notifier, typically) can wake it again
        # between attempts. The wait is short because this loop's own retry
        # delay already provides most of the patience.
        _, lock_detail = packagekit.wait_for_lock(timeout_s=packagekit.QUICK_WAIT_S)
        refresh_error, refresh_locked, refresh_output = _refresh()
        zypper = sources.check_zypper()

        still_locked = zypper.error is not None and (zypper.locked or refresh_locked)
        if not still_locked or attempts >= _LOCK_MAX_ATTEMPTS:
            break
        time.sleep(_LOCK_RETRY_DELAY_S)

    # Not over a question from the solver: the dry run did work something out,
    # namely that the user has to choose, and the window says so in its own
    # words (with the missing source named, when there is one).
    if (
        zypper.error is None
        and refresh_error
        and not zypper.packages
        and not zypper.needs_decision
    ):
        zypper.error = f"repository refresh failed: {refresh_error}"

    # Recorded whether or not the dry run found packages. When it did, this is
    # the only trace of the failure that reaches the window: the error above is
    # deliberately not set, because the upgrade can still go ahead without the
    # source that is missing.
    if refresh_error and not still_locked:
        zypper.failed_repos = _failed_sources(refresh_output)

    # check_zypper() only sees its own exit code, so a lock that showed up in
    # the refresh alone would otherwise be lost. The GUI reads this to decide
    # whether to offer the "free the lock" button.
    zypper.locked = still_locked

    if still_locked and attempts > 1:
        elapsed = (attempts - 1) * _LOCK_RETRY_DELAY_S
        suffix = f" ({lock_detail})" if lock_detail else ""
        zypper.error = (
            f"System management is still locked after {attempts} automatic "
            f"attempts over the last {elapsed}s{suffix}: {zypper.error}"
        )

    status = UpdateStatus(
        zypper=zypper,
        snapshots_ok=_snapshots_ok(),
        generated=datetime.datetime.now(datetime.timezone.utc).isoformat(
            timespec="seconds"
        ),
    )
    statusfile.write(status)
    return 0


if __name__ == "__main__":
    sys.exit(main())
