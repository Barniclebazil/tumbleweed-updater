#!/usr/bin/python3
"""Privileged read-only snapshot queries: list and compare.

Runs as root via pkexec. ``snapper list`` refuses to run as a normal user, so
even read-only listing needs this helper - unlike ``check``, there is no
passwordless case here (see data/org.opensuse.tumbleweedupdater.policy).

Usage:
    snapshots list
    snapshots status <pre-number> <post-number>

Both print a JSON result to stdout. Rolling back and deleting live in
``snapshots-manage``, behind their own polkit action: this one's authorisation
is cached (the dialog lists repeatedly), and a cached authorisation must not be
able to delete anything.

Every numeric argument is validated here before being handed to snapper -
polkit matches only the program path, so the arguments arrive untrusted.
"""

from __future__ import annotations

import json
import os
import sys

# Add the repository root when running from a checkout; see helper/check for why
# this is guarded.
_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if os.path.isdir(os.path.join(_REPO, "tumbleweed_updater")):
    sys.path.insert(0, _REPO)

from tumbleweed_updater import snapshots  # noqa: E402

_USAGE = "usage: snapshots <list|status <pre> <post>>\n"


def _int_arg(value: str) -> int | None:
    try:
        return int(value)
    except ValueError:
        return None


def _print_list() -> int:
    result = snapshots.list_snapshots()
    json.dump(
        {
            "error": result.error,
            "snapshots": [
                {
                    "number": s.number,
                    "type": s.type,
                    "date": s.date,
                    "description": s.description,
                    "cleanup": s.cleanup,
                    "pre_number": s.pre_number,
                }
                for s in result.snapshots
            ],
        },
        sys.stdout,
    )
    return 0


def _print_status(pre: int, post: int) -> int:
    result = snapshots.status_between(pre, post)
    json.dump(
        {
            "error": result.error,
            "changes": [{"status": c.status, "path": c.path} for c in result.changes],
        },
        sys.stdout,
    )
    return 0


def main() -> int:
    args = sys.argv[1:]
    if not args:
        sys.stderr.write(_USAGE)
        return 2

    action = args[0]

    if action == "list" and len(args) == 1:
        return _print_list()

    if action == "status" and len(args) == 3:
        pre, post = _int_arg(args[1]), _int_arg(args[2])
        if pre is None or post is None:
            sys.stderr.write("status: snapshot numbers must be integers\n")
            return 2
        return _print_status(pre, post)

    sys.stderr.write(_USAGE)
    return 2


if __name__ == "__main__":
    sys.exit(main())
