#!/usr/bin/python3
"""Privileged destructive snapshot operations: roll back and delete.

Runs as root via pkexec, under its own polkit action
(org.opensuse.tumbleweedupdater.snapshots-manage) with plain ``auth_admin``:
rolling back changes what boots next and deleting cannot be undone, so neither
may ride the cached authorisation that the read-only ``snapshots`` helper keeps
alive while the dialog refreshes its list.

Usage:
    snapshots-manage rollback <number>
    snapshots-manage delete <number>

Nothing is printed on success; failure is the exit code plus a stderr message,
the same convention as helper/set-interval. The snapshot number is validated
here before being handed to snapper - polkit matches only the program path, so
the arguments arrive untrusted.
"""

from __future__ import annotations

import os
import sys

# Add the repository root when running from a checkout; see helper/check for why
# this is guarded.
_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if os.path.isdir(os.path.join(_REPO, "tumbleweed_updater")):
    sys.path.insert(0, _REPO)

from tumbleweed_updater import snapshots  # noqa: E402

_USAGE = "usage: snapshots-manage <rollback|delete> <number>\n"


def main() -> int:
    args = sys.argv[1:]
    if len(args) != 2 or args[0] not in ("rollback", "delete"):
        sys.stderr.write(_USAGE)
        return 2

    action = args[0]
    try:
        number = int(args[1])
    except ValueError:
        sys.stderr.write(f"{action}: snapshot number must be an integer\n")
        return 2

    error = (
        snapshots.rollback_to(number)
        if action == "rollback"
        else snapshots.delete_snapshot(number)
    )
    if error:
        sys.stderr.write(error + "\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
