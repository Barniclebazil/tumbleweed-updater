#!/usr/bin/python3
"""Privileged switching of a software source on or off.

Runs as root via pkexec, under its own polkit action
(org.opensuse.tumbleweedupdater.repos) with plain ``auth_admin``: the check
action costs an active local session no authentication at all, so a source
change must not be able to ride anything cached, and a single change has no
repeat-operation reason to keep a credential alive.

Usage:
    repos disable <alias>
    repos enable  <alias>

Listing is deliberately absent: ``zypper repos`` works fine for an ordinary
user, so the GUI reads the list itself and only comes here to change it.

Nothing is printed on success; failure is the exit code plus a stderr message,
the same convention as helper/set-interval and helper/snapshots-manage. The
alias is validated against the real source list before zypper sees it - polkit
matches only the program path, never its arguments.
"""

from __future__ import annotations

import os
import sys

# Add the repository root when running from a checkout; see helper/check for why
# this is guarded.
_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if os.path.isdir(os.path.join(_REPO, "tumbleweed_updater")):
    sys.path.insert(0, _REPO)

from tumbleweed_updater import repos  # noqa: E402

_USAGE = "usage: repos <disable|enable> <alias>\n"


def main() -> int:
    args = sys.argv[1:]
    if len(args) != 2 or args[0] not in ("disable", "enable"):
        sys.stderr.write(_USAGE)
        return 2

    action, alias = args
    listing = repos.list_repos()
    if listing.error:
        sys.stderr.write(listing.error + "\n")
        return 1
    if listing.by_alias(alias) is None:
        # Not just a nicety: it is what stops an arbitrary string reaching
        # zypper's command line.
        sys.stderr.write(f"{action}: no such software source: {alias}\n")
        return 2

    error = repos.set_enabled(alias, enabled=action == "enable")
    if error:
        sys.stderr.write(error + "\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
