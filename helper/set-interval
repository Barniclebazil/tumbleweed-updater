#!/usr/bin/python3
"""Rewrite the update-check systemd timer.

Usage: set-interval <manual|hourly|every 3 hours|daily|weekly>

Runs as root via pkexec. The label is validated against a fixed allow-list and
the corresponding ``OnCalendar=`` expression is chosen here, not taken from the
caller.
"""

from __future__ import annotations

import os
import subprocess
import sys

# Add the repository root when running from a checkout; see helper/check for why
# this is guarded.
_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if os.path.isdir(os.path.join(_REPO, "tumbleweed_updater")):
    sys.path.insert(0, _REPO)

from tumbleweed_updater.intervals import INTERVALS, is_valid, oncalendar_for  # noqa: E402
from tumbleweed_updater.paths import CHECK_TIMER, CHECK_TIMER_DROPIN  # noqa: E402


def _remove_dropin() -> None:
    try:
        os.unlink(CHECK_TIMER_DROPIN)
    except FileNotFoundError:
        pass
    try:
        os.rmdir(os.path.dirname(CHECK_TIMER_DROPIN))
    except OSError:
        pass


_RELOAD_FAILED = "The system would not take up the new update-check schedule."


def _systemctl(failure: str, *args: str) -> bool:
    """Run systemctl, writing *failure* to stderr if it did not work.

    The settings dialog shows this helper's last stderr line when it exits
    non-zero, and keeps the old schedule; a failure swallowed here used to
    leave the dialog believing a schedule the timer never took up. *failure*
    is that line, so it is plain words: no command, no exit code.
    """
    try:
        proc = subprocess.run(["systemctl", *args], check=False)
    except OSError:
        proc = None
    if proc is None or proc.returncode != 0:
        sys.stderr.write(failure + "\n")
        return False
    return True


def main() -> int:
    if len(sys.argv) != 2 or not is_valid(sys.argv[1]):
        sys.stderr.write(
            "usage: set-interval <" + " | ".join(INTERVALS) + ">\n"
        )
        return 2

    label = sys.argv[1]
    if label == "manual":
        ok = _systemctl(
            "The system would not switch the background update check off.",
            "disable", "--now", CHECK_TIMER,
        )
        _remove_dropin()
        ok = _systemctl(_RELOAD_FAILED, "daemon-reload") and ok
        return 0 if ok else 1

    expr = oncalendar_for(label)
    os.makedirs(os.path.dirname(CHECK_TIMER_DROPIN), exist_ok=True)
    with open(CHECK_TIMER_DROPIN, "w", encoding="utf-8") as fh:
        fh.write(
            "# Managed by Tumbleweed Updater.\n"
            "[Timer]\n"
            "OnCalendar=\n"
            f"OnCalendar={expr}\n"
            "Persistent=true\n"
        )
    if not _systemctl(_RELOAD_FAILED, "daemon-reload"):
        return 1
    started = _systemctl(
        "The system would not start the background update check on the new "
        "schedule.",
        "enable", "--now", CHECK_TIMER,
    )
    return 0 if started else 1


if __name__ == "__main__":
    sys.exit(main())
